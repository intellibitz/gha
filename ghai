#!/usr/bin/env bash
# 🤖 ghai - GHA Master Agent (GMA) Launcher & Sole Interactor
# 100% Native Standalone Executable

set -e

CWD=$(pwd)
GLOBAL_GHA_DIR="$HOME/.gha"
GLOBAL_BIN_DIR="$GLOBAL_GHA_DIR/bin"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ⚡ Fast Native Executable Delegation (< 2ms)
NATIVE_BIN=""

if [ -f "$SCRIPT_DIR/target/release/gha" ] && [ -x "$SCRIPT_DIR/target/release/gha" ]; then
    NATIVE_BIN="$SCRIPT_DIR/target/release/gha"
elif [ -f "$GLOBAL_BIN_DIR/ghai-engine" ] && [ -x "$GLOBAL_BIN_DIR/ghai-engine" ]; then
    NATIVE_BIN="$GLOBAL_BIN_DIR/ghai-engine"
elif [ -f "$CWD/target/release/gha" ] && [ -x "$CWD/target/release/gha" ]; then
    NATIVE_BIN="$CWD/target/release/gha"
fi

if [ -n "$NATIVE_BIN" ]; then
    exec "$NATIVE_BIN" "$@"
fi

# Fallback: Compile native Rust binary if source is available in script directory
if [ -f "$SCRIPT_DIR/Cargo.toml" ]; then
    echo "⚡ [ghai Native] Compiling standalone Rust AI engine..."
    (cd "$SCRIPT_DIR" && cargo build --release >/dev/null 2>&1)
    if [ -f "$SCRIPT_DIR/target/release/gha" ]; then
        cp "$SCRIPT_DIR/target/release/gha" "$GLOBAL_BIN_DIR/ghai-engine" 2>/dev/null || true
        exec "$SCRIPT_DIR/target/release/gha" "$@"
    fi
fi

echo "❌ [ghai Native] Error: Standalone ghai binary not found in $GLOBAL_BIN_DIR/ghai-engine."
exit 1
