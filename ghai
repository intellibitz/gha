#!/usr/bin/env bash
# 🤖 ghai - Autonomous AI Workflow & Universal Command Processor
# 100% Sandboxed - 0% Modifications to existing project files.
# Any project, anywhere. 0 Effort, 100% Gain.

set -e

# Optimization: Allow skipping dependency refresh in CI environments to save time
REFRESH_FLAG="--refresh-dependencies"
if [ "$GHA_NO_REFRESH" = "1" ]; then
    REFRESH_FLAG=""
fi

INIT_SCRIPT=".gha/init.gradle.kts"
if [ ! -f "$INIT_SCRIPT" ] && [ -f "init/gha.init.gradle.kts" ]; then
    INIT_SCRIPT="init/gha.init.gradle.kts"
fi

# Support Gradle task path syntax (e.g. :version -> version)
RAW_ARG="$1"
CMD="${RAW_ARG#:}"

# 1. CORE GHA SUBCOMMANDS (Priority)
case "$CMD" in
    version|--version|-v)
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghai -Pmessage="--version"
        ;;
    status)
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaStatus
        ;;
    clone)
        shift
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaGitClone -PtargetRepo="$1" -Pdir="$2"
        ;;
    help)
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaHelp
        ;;
    install)
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew --refresh-dependencies -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaInit
        ;;
    reinstall)
        chmod +x gradlew 2>/dev/null || true
        echo "🧹 [ghai Reinstall] Performing clean removal..."
        ./gradlew -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaUninstall
        echo "⚡ [ghai Reinstall] Restoring sandbox..."
        mkdir -p .gha
        curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/init/gha.init.gradle.kts" -o ".gha/init.gradle.kts" 2>/dev/null || true
        curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/version.txt" -o "version.txt" 2>/dev/null || true
        exec ./gradlew --refresh-dependencies -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaInit
        ;;
    update)
        echo "🚀 [ghai Update] Fetching and updating gha to latest version..."
        curl -sSL https://raw.githubusercontent.com/intellibitz/gha/main/init/install.sh | bash
        echo "🎉 [ghai Update] Updated gha & ghai to latest version successfully!"
        exit 0
        ;;
    uninstall)
        echo "🧹 [ghai Uninstall] Completely removing gha sandbox, runner scripts, and workflows..."
        ./gradlew -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaUninstall
        echo "✨ [ghai Uninstall] gha removed completely with 0 lingering system modifications!"
        exit 0
        ;;
    ai)
        shift
        chmod +x gradlew 2>/dev/null || true
        SUBMODE="$1"
        if [ "$SUBMODE" = "orchestrate" ] || [ "$SUBMODE" = "models" ] || [ "$SUBMODE" = "engines" ] || [ "$SUBMODE" = "mcp-hub" ] || [ "$SUBMODE" = "download" ]; then
            exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaAiOrchestrate -Paction="$1" -Pmodel="$2" -Pfilter="$3" -Pgoal="$2"
        else
            exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaAiVision -Pmode="$1" -Pgoal="$2"
        fi
        ;;
esac

# 2. GRADLE TASK DETECTION
if [[ "$RAW_ARG" == ":"* ]]; then
    chmod +x gradlew 2>/dev/null || true
    exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" "$@"
fi

PROJECT_ROOT="$PWD"
while [ "$PROJECT_ROOT" != "/" ] && [ "$PROJECT_ROOT" != "." ]; do
    if [ -f "$PROJECT_ROOT/gradlew" ] || [ -d "$PROJECT_ROOT/.git" ]; then
        break
    fi
    PROJECT_ROOT="$(dirname "$PROJECT_ROOT")"
done
if [ "$PROJECT_ROOT" = "/" ] || [ "$PROJECT_ROOT" = "." ]; then
    PROJECT_ROOT="$PWD"
fi
cd "$PROJECT_ROOT"

# 3. SELF-HEALING BOOTSTRAP (If needed)
if [ ! -f "gradlew" ] || [ ! -s "gradlew" ]; then
    echo "📥 [ghai Self-Heal] Bootstrapping missing or broken Gradle wrapper..."
    mkdir -p "gradle/wrapper"
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradlew" -o "gradlew" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradlew.bat" -o "gradlew.bat" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradle/wrapper/gradle-wrapper.properties" -o "gradle/wrapper/gradle-wrapper.properties" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradle/wrapper/gradle-wrapper.jar" -o "gradle/wrapper/gradle-wrapper.jar" 2>/dev/null || true
    chmod +x "gradlew" 2>/dev/null || true
fi

if [ ! -f "$INIT_SCRIPT" ] || [ ! -d ".gha" ]; then
    echo "⚡ [ghai Self-Heal] Restoring gha sandbox..."
    mkdir -p .gha
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/init/gha.init.gradle.kts" -o ".gha/init.gradle.kts" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/version.txt" -o "version.txt" 2>/dev/null || true
    ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaInit
fi

# 4. GITHUB CLI (gh) MAPPING
# Detect if the command is a GitHub CLI subcommand
GH_COMMANDS="pr issue repo gist release workflow secret project run auth browse codespace variable api auth"
if [[ " $GH_COMMANDS " =~ " $CMD " ]]; then
    # Execute via GitHub CLI in the sandboxed environment
    export GITHUB_TOKEN=$(./gradlew -q $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" :ghai -Pmessage="--token-only" 2>/dev/null || echo "")
    if command -v gh >/dev/null 2>&1; then
        exec gh "$@"
    else
        echo "⚠️  GitHub CLI (gh) not found in PATH. Attempting via Gradle task..."
        # Fallback to gha tasks if possible or error
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghai "$@"
    fi
fi

# 5. UNIVERSAL COMMAND ROUTING
# Standard Git commands list:
GIT_COMMANDS="add commit push pull diff log status branch checkout stash tag reset fetch rebase merge init clone config remote show rm mv bisect notes worktree shortlog filter-branch cherry-pick"

if [ -n "$RAW_ARG" ]; then
    # Check if any argument is a Gradle flag or property
    IS_GRADLE=0
    GRADLE_FLAGS="--no-daemon --offline --stacktrace --info --debug --quiet --warn --scan --parallel --max-workers --configuration-cache --project-cache-dir --gradle-user-home"
    for arg in "$@"; do
        if [[ "$arg" == "-P"* ]] || [[ "$arg" == "-D"* ]]; then
            IS_GRADLE=1
            break
        fi
        for flag in $GRADLE_FLAGS; do
            if [ "$arg" = "$flag" ]; then
                IS_GRADLE=1
                break 2
            fi
        done
    done

    if [ "$IS_GRADLE" = "1" ]; then
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghai "$@"
    fi

    # Check if it's a known Gradle task (starts with gha)
    if [[ "$CMD" == gha* ]]; then
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" "$@"
    fi

    # Check if the command is a known Git subcommand
    IS_GIT=0
    for gitCmd in $GIT_COMMANDS; do
        if [ "$CMD" = "$gitCmd" ]; then
            IS_GIT=1
            break
        fi
    done

    if [ "$IS_GIT" = "1" ]; then
        exec git "$@"
    fi

    # Natural Language English Instruction detected!
    # Route to GHA Agent of Agents Orchestrator
    echo "🤖 [ghai Orchestrator] Natural Language Instruction detected: \"$*\""
    exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghaAiOrchestrate -Paction="agent" -Pgoal="$*"
fi

# Default (no arguments): Run autonomous AI workflow
exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script "$INIT_SCRIPT" ghai
