#!/usr/bin/env bash
# 🤖 ghai - GHA Master Agent (GMA) Launcher & Sole Interactor
# 100% Native Standalone Executable (0 JVM, 0 Git CLI, 0 Gradle, 0 GitHub)

set -e

CWD=$(pwd)
GLOBAL_GHA_DIR="$HOME/.gha"
GLOBAL_BIN_DIR="$GLOBAL_GHA_DIR/bin"

# ⚡ Fast Native Executable Delegation (< 2ms)
NATIVE_BIN=""
if [ -f "$CWD/target/release/gha" ]; then
    NATIVE_BIN="$CWD/target/release/gha"
elif [ -f "$GLOBAL_BIN_DIR/ghai" ]; then
    NATIVE_BIN="$GLOBAL_BIN_DIR/ghai"
elif [ -f "$(dirname "$0")/target/release/gha" ]; then
    NATIVE_BIN="$(dirname "$0")/target/release/gha"
elif [ -f "$(dirname "$0")/gha" ]; then
    NATIVE_BIN="$(dirname "$0")/gha"
fi

if [ -n "$NATIVE_BIN" ] && [ -x "$NATIVE_BIN" ]; then
    exec "$NATIVE_BIN" "$@"
else
    echo "⚡ [ghai Native] Compiling standalone Rust binary engine..."
    (cd "$(dirname "$0")" && cargo build --release >/dev/null 2>&1)
    exec "$(dirname "$0")/target/release/gha" "$@"
fi
