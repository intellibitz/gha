#!/usr/bin/env bash
# 🤖 ghai - Autonomous AI Workflow & Universal Command Processor
# 100% Sandboxed - 0% Modifications to existing project files.
# Any project, anywhere. 0 Effort, 100% Gain.

set -e

# Optimization: Allow skipping dependency refresh in CI environments to save time
REFRESH_FLAG="--refresh-dependencies"
if [ "$GHA_NO_REFRESH" = "1" ]; then
    REFRESH_FLAG=""
fi

# Support Gradle task path syntax (e.g. :version -> version)
RAW_ARG="$1"
CMD="${RAW_ARG#:}"

# 1. CORE GHA SUBCOMMANDS (Priority)
case "$CMD" in
    version|--version|-v)
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghai -Pmessage="--version"
        ;;
    status)
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaStatus
        ;;
    clone)
        shift
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaGitClone -PtargetRepo="$1" -Pdir="$2"
        ;;
    help)
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaHelp
        ;;
    install)
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew --refresh-dependencies -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaInit
        ;;
    reinstall)
        chmod +x gradlew 2>/dev/null || true
        echo "🧹 [ghai Reinstall] Performing clean removal..."
        ./gradlew -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaUninstall
        echo "⚡ [ghai Reinstall] Restoring sandbox..."
        mkdir -p init
        curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/init/gha.init.gradle.kts" -o "init/gha.init.gradle.kts" 2>/dev/null || true
        curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/version.txt" -o "version.txt" 2>/dev/null || true
        exec ./gradlew --refresh-dependencies -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaInit
        ;;
    update)
        echo "🚀 [ghai Update] Fetching and updating gha to latest version..."
        curl -sSL https://raw.githubusercontent.com/intellibitz/gha/main/init/install.sh | bash
        echo "🎉 [ghai Update] Updated gha & ghai to latest version successfully!"
        exit 0
        ;;
    uninstall)
        echo "🧹 [ghai Uninstall] Completely removing gha sandbox, runner scripts, and workflows..."
        ./gradlew -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaUninstall
        echo "✨ [ghai Uninstall] gha removed completely with 0 lingering system modifications!"
        exit 0
        ;;
    ai)
        shift
        chmod +x gradlew 2>/dev/null || true
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaAiVision -Pmode="$1" -Pgoal="$2"
        ;;
esac

# 2. GRADLE TASK DETECTION
if [[ "$RAW_ARG" == ":"* ]]; then
    chmod +x gradlew 2>/dev/null || true
    exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts "$@"
fi

PROJECT_ROOT="$PWD"
while [ "$PROJECT_ROOT" != "/" ] && [ "$PROJECT_ROOT" != "." ]; do
    if [ -f "$PROJECT_ROOT/gradlew" ] || [ -d "$PROJECT_ROOT/.git" ]; then
        break
    fi
    PROJECT_ROOT="$(dirname "$PROJECT_ROOT")"
done
if [ "$PROJECT_ROOT" = "/" ] || [ "$PROJECT_ROOT" = "." ]; then
    PROJECT_ROOT="$PWD"
fi
cd "$PROJECT_ROOT"

# 3. SELF-HEALING BOOTSTRAP (If needed)
if [ ! -f "gradlew" ] || [ ! -s "gradlew" ]; then
    echo "📥 [ghai Self-Heal] Bootstrapping missing or broken Gradle wrapper..."
    mkdir -p "gradle/wrapper"
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradlew" -o "gradlew" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradlew.bat" -o "gradlew.bat" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradle/wrapper/gradle-wrapper.properties" -o "gradle/wrapper/gradle-wrapper.properties" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradle/wrapper/gradle-wrapper.jar" -o "gradle/wrapper/gradle-wrapper.jar" 2>/dev/null || true
    chmod +x "gradlew" 2>/dev/null || true
fi

if [ ! -f "init/gha.init.gradle.kts" ] || [ ! -d ".gha" ]; then
    echo "⚡ [ghai Self-Heal] Restoring gha sandbox..."
    mkdir -p init
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/init/gha.init.gradle.kts" -o "init/gha.init.gradle.kts" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/version.txt" -o "version.txt" 2>/dev/null || true
    ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaInit
fi

# 4. GITHUB CLI (gh) MAPPING
# Detect if the command is a GitHub CLI subcommand
GH_COMMANDS="pr issue repo gist release workflow secret project run auth browse codespace variable"
if [[ " $GH_COMMANDS " =~ " $CMD " ]]; then
    # Execute via GitHub CLI in the sandboxed environment
    export GITHUB_TOKEN=$(./gradlew -q $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts :ghai -Pmessage="--token-only" 2>/dev/null || echo "")
    if command -v gh >/dev/null 2>&1; then
        exec gh "$@"
    else
        echo "⚠️  GitHub CLI (gh) not found in PATH. Attempting via Gradle task..."
        # Fallback to gha tasks if possible or error
        exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghai "$@"
    fi
fi

# 5. UNIVERSAL GIT FALLBACK
# If no recognized command was executed yet:
# - If it looks like a Gradle flag or property, run AI workflow
# - Otherwise, fallback to Git

if [ -z "$RAW_ARG" ] || [[ "$RAW_ARG" == "-"* ]]; then
    exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghai "$@"
fi

# If it's a known Gradle task (check for gha* prefix)
if [[ "$CMD" == gha* ]]; then
    exec ./gradlew $REFRESH_FLAG -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts "$@"
fi

echo "🛠️  [ghai] Command not recognized. Passing to Git engine..."
exec git "$@"
