#!/usr/bin/env bash
# 🤖 ghai - Autonomous AI Workflow Executable Launcher
# 100% Sandboxed - 0% Modifications to existing project files.

set -e

# Strip leading colon ':' if present to support Gradle task path syntax (e.g. :version -> version)
RAW_ARG="$1"
CMD="${RAW_ARG#:}"

# Handle "version" / ":version" / "--version" / "-v" sanity check
if [ "$CMD" = "version" ] || [ "$RAW_ARG" = "--version" ] || [ "$RAW_ARG" = "-v" ]; then
    chmod +x gradlew 2>/dev/null || true
    exec ./gradlew --refresh-dependencies -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghai -Pmessage="--version"
fi

# Handle "clone" / ":clone" action: ghai clone intellibitz / ghai :clone intellibitz
if [ "$CMD" = "clone" ]; then
    shift
    chmod +x gradlew 2>/dev/null || true
    exec ./gradlew --refresh-dependencies -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaGitClone -PtargetRepo="$1" -Pdir="$2"
fi

# Handle "status" / ":status" action
if [ "$CMD" = "status" ]; then
    chmod +x gradlew 2>/dev/null || true
    exec ./gradlew --refresh-dependencies -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaStatus
fi

# Handle "help" / ":help" action
if [ "$CMD" = "help" ]; then
    chmod +x gradlew 2>/dev/null || true
    exec ./gradlew --refresh-dependencies -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaHelp
fi

# Handle "update" / ":update" action: curl 1-step install to fetch latest ghai
if [ "$CMD" = "update" ]; then
    echo "🚀 [ghai Update] Fetching and updating gha to latest version..."
    curl -sSL https://raw.githubusercontent.com/intellibitz/gha/main/init/install.sh | bash
    echo "🎉 [ghai Update] Updated gha & ghai to latest version successfully!"
    exit 0
fi

# Handle "uninstall" / ":uninstall" action: completely remove gha and self-clean
if [ "$CMD" = "uninstall" ]; then
    echo "🧹 [ghai Uninstall] Completely removing gha sandbox, runner scripts, and workflows..."
    # Delegate to GHA Uninstall task to handle file logic safely
    ./gradlew -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaUninstall
    echo "✨ [ghai Uninstall] gha removed completely with 0 lingering system modifications!"
    exit 0
fi

PROJECT_ROOT="$PWD"
while [ "$PROJECT_ROOT" != "/" ]; do
    if [ -f "$PROJECT_ROOT/gradlew" ] || [ -d "$PROJECT_ROOT/.git" ]; then
        break
    fi
    PROJECT_ROOT="$(dirname "$PROJECT_ROOT")"
done

# Auto-scaffold minimal Gradle settings and build files ONLY IF MISSING (Scenario 1)
if [ ! -f "$PROJECT_ROOT/settings.gradle.kts" ] && [ ! -f "$PROJECT_ROOT/settings.gradle" ]; then
    PROJECT_NAME="$(basename "$PROJECT_ROOT")"
    cat << 'EOF' > "$PROJECT_ROOT/settings.gradle.kts"
// Generated by gha - Safe to delete during uninstall
pluginManagement {
    repositories {
        mavenLocal()
        mavenCentral()
        gradlePluginPortal()
    }
}
plugins {
    id("org.gradle.toolchains.foojay-resolver-convention") version "1.0.0"
}
EOF
    echo "rootProject.name = \"$PROJECT_NAME\"" >> "$PROJECT_ROOT/settings.gradle.kts"
fi

if [ ! -f "$PROJECT_ROOT/build.gradle.kts" ] && [ ! -f "$PROJECT_ROOT/build.gradle" ]; then
    cat << 'EOF' > "$PROJECT_ROOT/build.gradle.kts"
// Generated by gha - Safe to delete during uninstall
plugins {
    `kotlin-dsl`
}
EOF
fi

# Auto-bootstrap Gradle wrapper in project root if missing
if [ ! -f "$PROJECT_ROOT/gradlew" ]; then
    echo "📥 [ghai] Bootstrapping Gradle wrapper in $PROJECT_ROOT..."
    mkdir -p "$PROJECT_ROOT/gradle/wrapper"
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradlew" -o "$PROJECT_ROOT/gradlew" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradlew.bat" -o "$PROJECT_ROOT/gradlew.bat" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradle/wrapper/gradle-wrapper.properties" -o "$PROJECT_ROOT/gradle/wrapper/gradle-wrapper.properties" 2>/dev/null || true
    curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/gradle/wrapper/gradle-wrapper.jar" -o "$PROJECT_ROOT/gradle/wrapper/gradle-wrapper.jar" 2>/dev/null || true
    chmod +x "$PROJECT_ROOT/gradlew" 2>/dev/null || true
fi

cd "$PROJECT_ROOT"
chmod +x gradlew ghai 2>/dev/null || true

if [ ! -f "init/gha.init.gradle.kts" ] || [ ! -d ".gha" ]; then
    echo "⚡ [ghai] Initializing gha sandbox..."
    mkdir -p init
    if [ ! -f "init/gha.init.gradle.kts" ]; then
        curl -sSL "https://raw.githubusercontent.com/intellibitz/gha/main/init/gha.init.gradle.kts" -o "init/gha.init.gradle.kts" 2>/dev/null || true
    fi
    ./gradlew --refresh-dependencies -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghaInit
fi

exec ./gradlew --refresh-dependencies -Dgradle.user.home=.gha/gradle-user-home --init-script init/gha.init.gradle.kts ghai "$@"
